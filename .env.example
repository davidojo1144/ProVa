# Copy this file to .env.local and fill in the values.

# Public URL used by the browser to reach this app (used by Auth.js callbacks).
NEXTAUTH_URL=http://localhost:3000
# Random secret used to sign JWTs/session cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL for the centralized API client (src/services/api-client.ts).
# Exposed to the browser, so it must not contain secrets.
NEXT_PUBLIC_API_URL=/api
